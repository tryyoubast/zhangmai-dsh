{
  "name": "@deepseek-ai/dsh-novel-authoring",
  "description": "Workspace-scoped AI novel draft and proposal services",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/storage/novel-authoring"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "scripts": {
    "test": "pnpm --dir ../../../ exec node node_modules/vitest/vitest.mjs run --config vitest.config.ts packages/storage/novel-authoring/tests"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-database-postgres": "workspace:^",
    "@deepseek-ai/dsh-user-auth": "workspace:^"
  }
}
